# Copie para .env e ajuste os valores. Vale para as duas APIs.

# Obrigatório, mínimo 32 caracteres. Gere um com:
# node -p "require('crypto').randomBytes(48).toString('hex')"
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres

# Portas no seu computador.
EXPRESS_PORT=3000
FLASK_PORT=5000

# Opcionais (os valores abaixo são os padrões).
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=10
CORS_ORIGIN=*
BODY_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Imagem base do Flask (padrão: python:3.14-slim). Troque só se precisar.
# PYTHON_IMAGE=python:3.14-slim-bookworm
